# Choose your AI provider: "groq" (cloud, free tier, no local setup) or "ollama" (fully local, no API key)
AI_PROVIDER=groq

# --- Groq settings (used when AI_PROVIDER=groq) ---
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Ollama settings (used when AI_PROVIDER=ollama) ---
# Default Ollama server URL (leave as-is for a normal local install)
OLLAMA_BASE_URL=http://localhost:11434
# Any model you've pulled with `ollama pull <model>`, e.g. llama3.1, mistral, qwen2.5
OLLAMA_MODEL=llama3.1
